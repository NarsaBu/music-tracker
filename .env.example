# Environment for local development and for the Portainer stack.
# Locally: cp .env.example .env. Portainer: stack → Environment variables →
# "Load variables from .env file", then fill in the secrets.
# Variables are read by `make run-backend` / `make migrate-*` and by
# docker-compose.yml (which builds DATABASE_URL from POSTGRES_* vars).
# Full reference: docs/03-backend.md.

# ---------- required ----------
# Postgres password for the compose stack. Letters and digits only: it is
# embedded into DATABASE_URL. A change applies only to a fresh pgdata volume.
POSTGRES_PASSWORD=tracker
# Used by `make run-backend` / `make migrate-*` only (compose builds its own)
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable
# MusicBrainz requires a meaningful User-Agent with contact info (email or URL)
MB_USER_AGENT='MusicTracker/0.1 ( you@example.com )'

# ---------- deploy (docker compose) ----------
# Image tag, set to the deployed git tag (make release V=vX.Y.Z)
VERSION=dev
# Host port of the app (UI + API) in docker compose
HTTP_PORT=8080

# ---------- http ----------
HTTP_ADDR=:8080
# Origin of the UI: used in links (emails, feeds). On the server: the public URL.
PUBLIC_BASE_URL=http://localhost:5173
MIGRATE_ON_START=true

# ---------- logs ----------
LOG_LEVEL=info
# json | text
LOG_FORMAT=text

# ---------- musicbrainz ----------
MB_BASE_URL=https://musicbrainz.org/ws/2
# Requests per second, MusicBrainz allows at most 1
MB_RATE_LIMIT=1

# ---------- sync ----------
# Cron in UTC
SYNC_CRON='0 6 * * *'
SYNC_STALE_DAYS=90
WORKER_CONCURRENCY=4

# ---------- smtp ----------
# Empty SMTP_HOST/PORT locally = the mailpit trap: mail is caught, not delivered
# (UI: http://localhost:8025). On the server empty SMTP_HOST = no emails. For real delivery set your provider, e.g. Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<app password: myaccount.google.com/apppasswords, needs 2FA>
#   SMTP_FROM='Music Tracker <you@gmail.com>'  (Gmail rejects other senders)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM='Music Tracker <tracker@localhost>'
