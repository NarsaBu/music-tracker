# Environment for local development. Copy to .env: cp .env.example .env
# Variables are read by `make run-backend` / `make migrate-*` and by docker compose
# (the backend service; compose overrides DATABASE_URL, SMTP_HOST/PORT and
# PUBLIC_BASE_URL with in-network values). Full reference: docs/03-backend.md.
#
# Values containing `$` (APP_PASSWORD_HASH) MUST be in single quotes:
#   APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$...'

# ---------- required ----------
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable
# MusicBrainz requires a meaningful User-Agent with contact info (email or URL)
MB_USER_AGENT='MusicTracker/0.1 ( you@example.com )'

# ---------- access ----------
# Empty = no login (only for localhost). Generate: make hash-password
APP_PASSWORD_HASH=
# At least 32 characters, required when APP_PASSWORD_HASH is set: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL=720h

# ---------- http ----------
HTTP_ADDR=:8080
# Origin of the UI: used in links (emails, feeds) and for the CSRF Origin check
PUBLIC_BASE_URL=http://localhost:5173
MIGRATE_ON_START=true

# ---------- logs ----------
LOG_LEVEL=info
# json | text
LOG_FORMAT=text

# ---------- musicbrainz ----------
MB_BASE_URL=https://musicbrainz.org/ws/2
# Requests per second, MusicBrainz allows at most 1
MB_RATE_LIMIT=1

# ---------- sync ----------
# Cron in UTC
SYNC_CRON='0 6 * * *'
SYNC_STALE_DAYS=90
WORKER_CONCURRENCY=4

# ---------- smtp (mailpit in dev, UI: http://localhost:8025) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM='Music Tracker <tracker@localhost>'
