# Environment for local development. Copy to .env: cp .env.example .env
# Variables are read by `make run-backend` / `make migrate-*` and by docker compose
# (the backend service; compose overrides DATABASE_URL and PUBLIC_BASE_URL with
# in-network values). Full reference: docs/03-backend.md.

# ---------- required ----------
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable
# MusicBrainz requires a meaningful User-Agent with contact info (email or URL)
MB_USER_AGENT='MusicTracker/0.1 ( you@example.com )'

# ---------- http ----------
HTTP_ADDR=:8080
# Origin of the UI: used in links (emails, feeds)
PUBLIC_BASE_URL=http://localhost:5173
MIGRATE_ON_START=true

# ---------- logs ----------
LOG_LEVEL=info
# json | text
LOG_FORMAT=text

# ---------- musicbrainz ----------
MB_BASE_URL=https://musicbrainz.org/ws/2
# Requests per second, MusicBrainz allows at most 1
MB_RATE_LIMIT=1

# ---------- sync ----------
# Cron in UTC
SYNC_CRON='0 6 * * *'
SYNC_STALE_DAYS=90
WORKER_CONCURRENCY=4

# ---------- smtp ----------
# Empty SMTP_HOST/PORT = the mailpit trap: mail is caught, not delivered
# (UI: http://localhost:8025). For real delivery set your provider, e.g. Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<app password: myaccount.google.com/apppasswords, needs 2FA>
#   SMTP_FROM='Music Tracker <you@gmail.com>'  (Gmail rejects other senders)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM='Music Tracker <tracker@localhost>'
